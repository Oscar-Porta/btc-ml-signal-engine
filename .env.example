# Copy this file to `.env` and fill in your own values.
# Every integration is optional: the research pipeline (steps 01–07)
# only needs public Binance market data and no credentials at all.

# --- Telegram (live signal notifications) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                     # internal "all signals" channel
TELEGRAM_BTC_FULLTIME_SELECTIVO=      # product channel (signals with p >= 0.60)

# --- Supabase (optional signal history for a web dashboard) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional settings ---
MODEL_FILE=outputs/model_limit_btc.joblib
DASHBOARD_URL=http://localhost:8501
TRACK_BASE_URL=                       # public history page base URL (leave empty to disable links)

# --- Binance testnet (optional paper trading) ---
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
TELEGRAM_TESTNET_CHAT_ID=
